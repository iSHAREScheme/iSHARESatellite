# Onboarding portal .env - rendered by scripts/deployOnboardingPortal.sh.
# <TOKENS> are substituted from .env.server values + the registry's owner identity.
# NEXT_PUBLIC_* are read at runtime by the frontend (write-env.js) and are safe defaults
# for a "manage participants in the registry" deployment - tune as needed.

# --- Images ----------------------------------------------------------------
GHCR_OWNER=<ONBOARDING_GHCR_OWNER>
IMAGE_TAG=<ONBOARDING_IMAGE_TAG>
ONBOARDING_GHCR_OWNER=<ONBOARDING_GHCR_OWNER>
ONBOARDING_IMAGE_TAG=<ONBOARDING_IMAGE_TAG>

# --- Satellite connection (reuse the registry OWNER identity) --------------
# Internal URL on fabric_network; the portal backend connects directly to PR-MW.
SATELLITE_BASE_URL=http://middleware-ishare_mw-1:21001
SATELLITE_TOKEN_ENDPOINT=/connect/token
SATELLITE_TOKEN_SCOPE=iSHARE
SATELLITE_EP_CREATION_ENDPOINT=/ep_creation
# Pinned to the satellite's framework era; detection falls back in the portal.
SATELLITE_VERSION=<SATELLITE_VERSION>
SATELLITE_VERSION_DETECT=true
SATELLITE_ISS=<SATELLITE_EORI>
SATELLITE_AUD=<SATELLITE_EORI>
REGISTRAR_ID=<SATELLITE_EORI>
# Owner leaf certificate (x5c) + private key mounted at /app/keys/sat-key.pem.
SATELLITE_X5C=<SATELLITE_X5C>
SATELLITE_PRIVATE_KEY=
SATELLITE_PRIVATE_KEY_PATH=/app/keys/sat-key.pem
SATELLITE_DEBUG=false

# --- Participant Registry admin API (co-deployed only) ---------------------
# The PR-MW /api/* admin surface ("SO.api") - the SAME co-located middleware as
# SATELLITE_BASE_URL, just the bearer-protected admin routes. Set ONLY in shared
# Keycloak mode, where portal operators live in the registry realm so the token
# the portal forwards is signed by the realm the PR validates against. Blank means
# the registry-admin features (network health, revoke, transfer, dataspace +
# trusted-list management, scheduler) stay hidden + unreachable in the portal.
PR_API_BASE_URL=<PR_API_BASE_URL>

# --- Inbound auth (validate portal-Keycloak tokens) ------------------------
OIDC_DISABLE=false
OIDC_ISSUER=<KC_PUBLIC_URL>/realms/<KC_REALM>
OIDC_JWKS_URL=<KC_INTERNAL_URL>/realms/<KC_REALM>/protocol/openid-connect/certs
OIDC_AUDIENCE=account

# --- Keycloak (admin API + bootstrap) --------------------------------------
KEYCLOAK_ADMIN_BASE_URL=<KC_INTERNAL_URL>
KEYCLOAK_ADMIN_USERNAME=<KC_ADMIN_USER>
KEYCLOAK_ADMIN_PASSWORD=<KC_ADMIN_PASSWORD>
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=<KC_DB_PASSWORD>
KEYCLOAK_SMTP_HOST=<SMTP_HOST>
KEYCLOAK_SMTP_PORT=<SMTP_PORT>
KEYCLOAK_SMTP_USER=<SMTP_USER>
KEYCLOAK_SMTP_PASS=<SMTP_PASSWORD>
KEYCLOAK_SMTP_FROM=<SMTP_FROM>

# --- Initial portal admin (onboarding-admin) -------------------------------
OBP_ADMIN_EMAIL=<OBP_ADMIN_EMAIL>
OBP_ADMIN_PASSWORD=<OBP_ADMIN_PASSWORD>

# --- Frontend (NEXT_PUBLIC_*) ----------------------------------------------
# Server-side proxy target for the frontend's /api/backend route (private network).
NEXT_PUBLIC_BASE_SERVER_URL=http://obp-backend:8081
NEXT_PUBLIC_FRONTEND_DOMAIN=https://<ONBOARDING_UI_HOSTNAME>
NEXT_PUBLIC_KEYCLOAK_BASE_URL=<KC_PUBLIC_URL>
NEXT_PUBLIC_KEYCLOAK_REALM=<KC_REALM>
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend
NEXT_PUBLIC_KEYCLOAK_IDP=
NEXT_PUBLIC_IDP_ONLY=false
NEXT_PUBLIC_DISABLE_ADMIN_ROUTES=false
NEXT_PUBLIC_DEFAULT_ASSOCIATION_NAME=<SATELLITE_PARTY_NAME>

# --- Backend misc ----------------------------------------------------------
SERVER_PORT=8081
SQLITE_DB_NAME=/app/db/onboarding
