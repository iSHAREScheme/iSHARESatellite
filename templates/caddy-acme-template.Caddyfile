{
  email <ACME_EMAIL>
<ACME_CA_LINE>
}

http://<UIHostName>, http://<MiddlewareHostName>, http://<KeycloakHostName> {
  redir https://{host}{uri} 308
}

https://<UIHostName> {
  # Preserve same-origin /api behavior from nginx: strip the first /api prefix.
  @api_root path /api
  redir @api_root /api/ 308

  handle_path /api/* {
    reverse_proxy 127.0.0.1:5001
  }

<GRAFANA_CADDY_ROUTES>

  handle {
    reverse_proxy 127.0.0.1:4200
  }
}

https://<MiddlewareHostName> {
  reverse_proxy 127.0.0.1:5001
}

https://<KeycloakHostName> {
  @master_token path /auth/realms/master/protocol/openid-connect/token
  handle @master_token {
    reverse_proxy 127.0.0.1:8080
  }

  @keycloak_admin_or_master path /auth/admin* /auth/realms/master*
  respond @keycloak_admin_or_master 403

  reverse_proxy 127.0.0.1:8080
}
