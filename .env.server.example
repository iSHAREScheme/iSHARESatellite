# Server deploy environment template for scripts/install-server.sh
#
# Notes:
# - Values are shell exports and are sourced by deployment scripts.
# - REPO_ROOT is provided by install-server.sh at runtime.
# - Replace placeholders before running in non-interactive mode.

# Core identity
export ORG_NAME=mysatellite
export SUB_DOMAIN=test.example.com
export ENVIRONMENT=test

# Fabric CA/bootstrap defaults
export REGISTERAR_NAME=admin
export ENROLLMENT_SECRET=adminpw
export FABRIC_CA_ADDRESS=localhost:7054
export PEER_COUNT=2
export ORDERER_COUNT=0

# Shared network onboarding values
export ORDERER_ADDRESS=orderer1.example.aks.io:443
export ORDERER_TLS_CA_CERT="${REPO_ROOT}/ca-ishareord.pem"
export ORDERER_TLS_HOSTNAME_OVERRIDE=
export CHANNEL_NAME=appchannel
export ANCHOR_PEER_HOSTNAME="peer0.${ORG_NAME}.${SUB_DOMAIN}"
export ANCHOR_PEER_PORT_NUMBER=7051

# Chaincode
export CHAINCODE_LABEL=isharecc_1.0
export CHAINCODE_NAME=isharecode
export CHAINCODE_VERSION=v1
export CHAINCODE_SEQUENCE=1
export CHAINCODE_POLICY="OR('${ORG_NAME}.member')"
# Optional override. Leave blank to auto-detect from `peer lifecycle chaincode queryinstalled`.
export CC_PACKAGE_ID=
export PEER_ADMIN_MSP_DIR="${REPO_ROOT}/app/${ENVIRONMENT}/${ORG_NAME}/crypto/peerOrganizations/${ORG_NAME}.${SUB_DOMAIN}/users/Admin@${ORG_NAME}.${SUB_DOMAIN}/msp"

# App/runtime values
export PARTY_ID=EU.EORI.NL000000000
export PARTY_NAME="Example Organization"
export TLS_MODE=manual
# HTTPS for UI/Middleware/Keycloak is controlled by TLS_MODE:
# - manual: provide ssl/tls.crt + ssl/tls.key
# - acme: Caddy ACME edge provisions/renews HTTPS certificates
# Required when TLS_MODE=acme.
export ACME_EMAIL=
export ACME_STAGING=false
# Optional ACME directory endpoint override. Leave empty for Let's Encrypt defaults.
export ACME_CA_SERVER=
# Directory where ACME account/certificate state is persisted.
export ACME_STORAGE_PATH=.local-state/acme
# Current implementation supports only 80/443.
export ACME_HTTP_PORT=80
export ACME_HTTPS_PORT=443

# Optional Grafana/Loki/Alloy logging stack.
# Exposes Grafana under https://${UIHostName}${GRAFANA_PUBLIC_PATH}/ and creates/updates
# a Keycloak OIDC client in the participant registry realm.
export DEPLOY_GRAFANA=false
export GRAFANA_PUBLIC_PATH=/logs
export GRAFANA_PORT=3200
export GRAFANA_ADMIN_USER=admin
# If empty, deployGrafana.sh generates and persists a password in observability/grafana-admin-password.
export GRAFANA_ADMIN_PASSWORD=
export GRAFANA_KEYCLOAK_CLIENT_ID=grafana
# If empty, deployGrafana.sh generates and persists a client secret in observability/grafana-client-secret.
export GRAFANA_KEYCLOAK_CLIENT_SECRET=
export GRAFANA_LOKI_PORT=3100
export GRAFANA_ALLOY_CONFIG=observability/configs/config.alloy

export UIHostName=satellite.example.com
export MiddlewareHostName=satellite-mw.example.com
export KeycloakHostName=satellite-kc.example.com

# JWT signing material is always read from:
# - jwt-rsa/jwtRSA256-public.pem
# - jwt-rsa/jwtRSA256-private.pem
# This can come from qualified eIDAS seal material and is separate from HTTPS TLS certs.
# Guided install can prompt you to paste these PEM contents when the files are missing.
# Non-interactive installs should copy the files before app-deploy.
# SMTP/email
export SMTP_PORT=587
export SMTP_HOST=smtp.example.com
export SMTP_USER=noreply@example.com
export SMTP_PASSWORD=change-me
export DISPLAY_NAME="iSHARE Satellite"

# Initial portal admin bootstrap (created during app-deploy)
export SATELLITE_ADMIN_USERNAME=satelliteadmin
export SATELLITE_ADMIN_EMAIL="satelliteadmin@${SUB_DOMAIN}"
export SATELLITE_ADMIN_ROLE_NAME=SatelliteAdmin
# Set explicitly in production. If empty, installer generates a temporary password.
export SATELLITE_ADMIN_PASSWORD=
# If true, user must set a new password at first successful login.
export SATELLITE_ADMIN_FORCE_PASSWORD_CHANGE=true
# If true, user must enroll OTP/TOTP at first successful login.
export SATELLITE_ADMIN_FORCE_OTP_SETUP=true

# ---------------------------------------------------------------------------
# Optional: onboarding portal alongside the participant registry
# When true, install-server.sh also deploys the portal (backend + frontend +
# Keycloak + Postgres) from prebuilt GHCR images, wired to the satellite
# middleware using the registry OWNER identity.
# ---------------------------------------------------------------------------
export DEPLOY_ONBOARDING_PORTAL=false

# Public hostnames. DNS must point to this VM; ACME provisions certificates in acme mode.
export ONBOARDING_UI_HOSTNAME=          # e.g. onboarding.dev.ishareworks.nl
export ONBOARDING_KC_HOSTNAME=          # portal Keycloak host, only for ONBOARDING_KEYCLOAK_MODE=own

# Prebuilt images: <registry>/onboarding-portal-{backend,frontend,keycloak}
# ONBOARDING_IMAGE_REGISTRY empty = ghcr.io/<ONBOARDING_GHCR_OWNER> (releases up to
# v1.2-rc.51). Releases built on GitLab (public, no login needed):
#   registry.gitlab.com/ishare-foundation/reference-implementations/participant-registry/satellite-ui
export ONBOARDING_GHCR_OWNER=isharescheme
export ONBOARDING_IMAGE_REGISTRY=registry.gitlab.com/ishare-foundation/reference-implementations/participant-registry/satellite-ui
export ONBOARDING_IMAGE_TAG=v1.2-rc.55
# GHCR auth to pull private images. Use a GitHub token with read:packages.
export ONBOARDING_GHCR_USERNAME=
export ONBOARDING_GHCR_TOKEN=

# Framework version the portal operates against.
export ONBOARDING_SATELLITE_VERSION=3.0

# Optional OWNER identity override for onboarding M2M auth. When blank, onboarding
# reuses jwt-rsa/jwtRSA256-private.pem and jwtRSA256-public.pem from this deployment.
# If set, the directory must contain key.pem and cert-chain.pem.
export ONBOARDING_OWNER_CERT_DIR=
export ONBOARDING_SATELLITE_EORI="${PARTY_ID}"
# Optional explicit x5c override. By default this is derived from the owner chain.
export ONBOARDING_SATELLITE_X5C=

# Keycloak topology:
#   own    = the portal runs its own Keycloak at ONBOARDING_KC_HOSTNAME.
#   shared = one Keycloak serves both the satellite and onboarding realms at KeycloakHostName/auth.
export ONBOARDING_KEYCLOAK_MODE=own

# Portal admin, portal Keycloak admin, and portal database credentials.
export ONBOARDING_ADMIN_EMAIL=
export ONBOARDING_ADMIN_PASSWORD=
export ONBOARDING_KC_ADMIN_USERNAME=admin
export ONBOARDING_KC_ADMIN_PASSWORD=
export ONBOARDING_DB_PASSWORD=

# Optional issuer webhook integration surfaced in the onboarding portal settings.
export ONBOARDING_VC_ISSUER_BASE_URL=
export ONBOARDING_VC_ISSUER_API_KEY=
